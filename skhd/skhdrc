# skhd 快捷键 —— 与 aerospace.toml 的 [mode.*.binding] 一一对应（yabai 版）
# 链接到 ~/.config/skhd/skhdrc；aero 是 ../yabai/aero，用来模拟 AeroSpace 的命令。
#
# 切换工作区（⌥1 … ⌥9 ⌥0 = 工作区 1 … 10，⌥Z ⌥X ⌥C ⌥B ⌥N ⌥M ⌥T = 工作区 Z X C B N M T）和 ⌃H/⌃L 在文件末尾 .load 的 workspaces.skhdrc 里：
# 它由 aero keys 按 SA 是否可用，链接到 workspaces-sa.skhdrc 或 workspaces-native.skhdrc。

# 进入每个模式时通知 SketchyBar 顶栏显示 / 隐藏 RESIZE、SERVICE（没装 SketchyBar 也不影响）
:: default : sketchybar --trigger skhd_mode MODE=default 2>/dev/null
:: resize  : sketchybar --trigger skhd_mode MODE=resize 2>/dev/null
:: service : sketchybar --trigger skhd_mode MODE=service 2>/dev/null

# ================================================================ mode.main

# focus left/down/up/right
alt - h     : yabai -m window --focus west
alt - j     : yabai -m window --focus south
alt - k     : yabai -m window --focus north
alt - l     : yabai -m window --focus east
alt - left  : yabai -m window --focus west
alt - down  : yabai -m window --focus south
alt - up    : yabai -m window --focus north
alt - right : yabai -m window --focus east

# move left/down/up/right
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east
# 方向键版（代价：所有应用里按词选择 ⌥⇧←→、按段选择 ⌥⇧↑↓ 都被占掉）
alt + shift - left  : yabai -m window --swap west
alt + shift - down  : yabai -m window --swap south
alt + shift - up    : yabai -m window --swap north
alt + shift - right : yabai -m window --swap east

# fullscreen / layout floating tiling
alt - f         : $HOME/.config/yabai/aero fullscreen
alt + shift - f : $HOME/.config/yabai/aero toggle-float

# resize smart -50 / +50（⌥- ⌥=）
alt - 0x1B : $HOME/.config/yabai/aero resize smart -50
alt - 0x18 : $HOME/.config/yabai/aero resize smart +50

# ⌥⇧1 … ⌥⇧9 ⌥⇧0：把当前窗口移到工作区 1 … 10，并跟过去
alt + shift - 1 : $HOME/.config/yabai/aero move-node-to-workspace 1 --focus-follows-window
alt + shift - 2 : $HOME/.config/yabai/aero move-node-to-workspace 2 --focus-follows-window
alt + shift - 3 : $HOME/.config/yabai/aero move-node-to-workspace 3 --focus-follows-window
alt + shift - 4 : $HOME/.config/yabai/aero move-node-to-workspace 4 --focus-follows-window
alt + shift - 5 : $HOME/.config/yabai/aero move-node-to-workspace 5 --focus-follows-window
alt + shift - 6 : $HOME/.config/yabai/aero move-node-to-workspace 6 --focus-follows-window
alt + shift - 7 : $HOME/.config/yabai/aero move-node-to-workspace 7 --focus-follows-window
alt + shift - 8 : $HOME/.config/yabai/aero move-node-to-workspace 8 --focus-follows-window
alt + shift - 9 : $HOME/.config/yabai/aero move-node-to-workspace 9 --focus-follows-window
alt + shift - 0 : $HOME/.config/yabai/aero move-node-to-workspace 10 --focus-follows-window
# ⌥⇧Z ⌥⇧X ⌥⇧C ⌥⇧B ⌥⇧N ⌥⇧M ⌥⇧T：移到工作区 Z X C B N M T（桌面 11 … 17）
alt + shift - z : $HOME/.config/yabai/aero move-node-to-workspace Z --focus-follows-window
alt + shift - x : $HOME/.config/yabai/aero move-node-to-workspace X --focus-follows-window
alt + shift - c : $HOME/.config/yabai/aero move-node-to-workspace C --focus-follows-window
alt + shift - b : $HOME/.config/yabai/aero move-node-to-workspace B --focus-follows-window
alt + shift - n : $HOME/.config/yabai/aero move-node-to-workspace N --focus-follows-window
alt + shift - m : $HOME/.config/yabai/aero move-node-to-workspace M --focus-follows-window
alt + shift - t : $HOME/.config/yabai/aero move-node-to-workspace T --focus-follows-window

# move-workspace-to-monitor --wrap-around next
alt + shift - tab : $HOME/.config/yabai/aero move-workspace-to-monitor --wrap-around next

# 应用切换器（⌥⇥）和窗口列表（⌘⇥，macOS 自带的由 yabairc 关掉；⌘Space 直接弹出应用列表，Spotlight 的快捷键同样关掉）
#   ⌥⇥ 快速按一下 = 回到上一个用过的应用，按住 ⌥ = 弹出应用列表；⌘⇥ 直接弹出窗口列表（上一个用过的窗口已选中，回车就回去）
#   列表里打字直接搜索：按键不经过输入法，搜狗之类不用切走
#   应用列表里是启动台里的所有应用：有窗口的在最上面，然后是开着但没窗口的，最后是没开的
# 列表开着时 skhd 不拦截任何键（见下面的 .blacklist）：⌥⇥ / ⌥⇧⇥（⌘⇥ / ⌘⇧⇥）在列表里往下 / 往上选，Esc 关闭
alt - tab : $HOME/.config/yabai/window_switcher --apps --key option --auto
cmd - tab : $HOME/.config/yabai/window_switcher --list
cmd - space : $HOME/.config/yabai/window_switcher --apps --list
.blacklist [
    "aero-helper"
]

# ⌥⇧↩：临时关掉顶上的 SketchyBar 栏，换回常显的系统菜单栏；再按一次换回来
alt + shift - return : $HOME/.config/yabai/aero toggle-bar

# ⌥D：当前工作区开 Finder；⌥⇧D：当前工作区新开一个 Finder 窗口，打开文稿
alt - d         : $HOME/.config/yabai/new_window_here
alt + shift - d : $HOME/.config/yabai/new_window_here "$HOME/Documents"

# ⌥G = 工作区 1 的默认浏览器：那里有它的窗口就切过去，没有就切到工作区 1 新开一个
alt - g : $HOME/.config/yabai/focus_browser
# ⌥ + Caps Lock = ⌥0（工作区 10）：skhd 绑不了 Caps Lock（外接键盘上改成了 🌐/fn），
# 由 yabairc 启动的 aero-helper option-fn 监听

# mode resize / mode service
alt - r  ; resize
ctrl - s ; service

# ================================================================ mode.service
# skhd 的一个按键不能同时"执行命令 + 切换模式"：命令最后用 skhd -k "f20" 回到 default

service < escape : skhd -k "f20"; $HOME/.config/yabai/aero reload
service < r      ; resize
service < f      : skhd -k "f20"; $HOME/.config/yabai/aero toggle-space-float
service < space  ; default
service < j      : yabai -m window --toggle split; skhd -k "f20"
service < h      : yabai -m window --insert east; skhd -k "f20"
service < v      : yabai -m window --insert south; skhd -k "f20"
# ⌃S M：记住当前应用的布局（平铺 / 浮动），以后它新开的窗口都这样（按着 ⌃ 按 M 也行）
service < m        : skhd -k "f20"; $HOME/.config/yabai/aero remember-layout
service < ctrl - m : skhd -k "f20"; $HOME/.config/yabai/aero remember-layout
# ⌃S W：记住当前应用的工作区，以后它新开的窗口都去那里（盖过 yabairc 里写死的）
service < w        : skhd -k "f20"; $HOME/.config/yabai/aero remember-workspace
service < ctrl - w : skhd -k "f20"; $HOME/.config/yabai/aero remember-workspace
service < f20    ; default

# ================================================================ mode.resize

resize < 0x1B  : $HOME/.config/yabai/aero resize smart -50
resize < 0x18  : $HOME/.config/yabai/aero resize smart +50
resize < h     : $HOME/.config/yabai/aero resize width -50
resize < j     : $HOME/.config/yabai/aero resize height +50
resize < k     : $HOME/.config/yabai/aero resize height -50
resize < l     : $HOME/.config/yabai/aero resize width +50
resize < left  : $HOME/.config/yabai/aero resize width -50
resize < up    : $HOME/.config/yabai/aero resize height +50
resize < down  : $HOME/.config/yabai/aero resize height -50
resize < right : $HOME/.config/yabai/aero resize width +50
resize < return ; default
resize < escape ; default
resize < space  ; default

# ================================================================ 工作区切换

.load "workspaces.skhdrc"
