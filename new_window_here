#!/usr/bin/env bash
# ⌥D：把一个 Finder 窗口拿到当前工作区并聚焦；一个 Finder 窗口都没有就新开一个。
# ⌥⇧D：new_window_here <文件夹>：在当前工作区新开一个 Finder 窗口，打开这个文件夹（skhdrc 里是 ~/Documents）。
# yabai 和 AeroSpace 都支持（看哪个在运行）。

# 带文件夹：总是新开（新窗口开在当前桌面上；"切换到有它窗口的空间"是关着的，激活 Finder 不会跳走）
if [ -n "$1" ] && [ -d "$1" ]; then
    # 参数别叫 folder：在 tell Finder 里它是访达的"文件夹"类型（'cfol'），会报"无法将 file \":cfol\" 转成 alias"
    osascript -e 'on run {thePath}' \
              -e 'set theFolder to (POSIX file thePath) as alias' \
              -e 'tell application "Finder"' \
              -e 'make new Finder window to theFolder' \
              -e 'activate' \
              -e 'end tell' \
              -e 'end run' "$1" >/dev/null
    exit 0
fi

if pgrep -xq yabai; then
    YABAI=/opt/homebrew/bin/yabai
    JQ=/opt/homebrew/bin/jq
    cur=$("$YABAI" -m query --spaces --space | "$JQ" -r .index)
    # 优先用当前工作区上的 Finder 窗口
    id=$("$YABAI" -m query --windows | "$JQ" -r --argjson cur "$cur" '
        [.[] | select(.app == "Finder" and .subrole == "AXStandardWindow" and (."is-minimized" | not))]
        | (map(select(.space == $cur)) + .)[0].id // empty')
    if [ -n "$id" ]; then
        "$YABAI" -m window "$id" --space "$cur" 2>/dev/null
        for _ in 1 2 3 4 5; do
            if [ "$("$YABAI" -m query --windows --window "$id" | "$JQ" -r .space)" = "$cur" ]; then
                "$YABAI" -m window --focus "$id"
                exit 0
            fi
            sleep 0.05
        done
    fi
    # 没有 Finder 窗口，或者没有 SA 移不过来：直接在当前工作区新开一个
    osascript -e 'tell application "Finder" to make new Finder window' \
              -e 'tell application "Finder" to activate'
    exit 0
fi

# ---- AeroSpace ----
APP=${1:-Finder}
WINDOW_ID=$(aerospace list-windows --all --format "%{window-id} %{app-name}" | grep " Finder" | head -n1 | cut -d" " -f1)
WORKSPACE_ID=$(aerospace list-workspaces --focused)

if [ -z "$WINDOW_ID" ]; then
    osascript -e "tell application \"Finder\" to make new Finder window"
    sleep 0.3
    WINDOW_ID=$(aerospace list-windows --all --format "%{window-id} %{app-name}" | grep " Finder" | head -n1 | cut -d" " -f1)
fi

aerospace move-node-to-workspace --window-id "$WINDOW_ID" "$WORKSPACE_ID" --fail-if-noop

aerospace focus --window-id "$WINDOW_ID"
